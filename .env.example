# Required by SEC EDGAR — every request must identify a real name + email.
# A placeholder default exists but SEC may rate-limit or block it.
EDGAR_IDENTITY=Your Name your@email.com

# Optional — only needed for LLM rate-parsing fallback.
# Regex handles all 111 FDUS debt rows without it; the package runs fine with no key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional — override the default model string.
# BDC_PARSER_MODEL=anthropic:claude-sonnet-4-6
